{
  "name": "dsh-mood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "鱼的心情：mood 0~100 + 七个情绪维度、半衰期衰减、每轮一行注入、对外开放事件入口（feeling/sulk/life 可直接喂事件）",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT"
}
